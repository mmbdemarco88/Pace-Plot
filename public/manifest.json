{
  "id": "com.stridecircuit.paceplot",
  "name": "Pace Plot - Safe Run & Walk Navigation",
  "short_name": "Pace Plot",
  "description": "Safe run and walk navigation app featuring AI safe loops, live GPS telemetry, voice guidance, and health biometrics.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "url": "/",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    "new_tab_button": {
      "url": "/?newrun=1"
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "background_color": "#0B0C0E",
  "theme_color": "#E15A2B",
  "orientation": "portrait-primary",
  "lang": "en-US",
  "dir": "ltr",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.stridecircuit.paceplot",
      "id": "com.stridecircuit.paceplot"
    },
    {
      "platform": "webapp",
      "url": "https://ais-pre-2pismjncofqbc3fhyd5a44-460005074201.us-east1.run.app/manifest.json"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://stride-circuit-llc.polsia.io"
    },
    {
      "origin": "https://ais-dev-2pismjncofqbc3fhyd5a44-460005074201.us-east1.run.app"
    }
  ],
  "note_taking": {
    "new_note_url": "/?newnote=runlog"
  },
  "protocol_handlers": [
    {
      "protocol": "web+paceplot",
      "url": "/?route=%s"
    },
    {
      "protocol": "geo",
      "url": "/?geo=%s"
    }
  ],
  "share_target": {
    "action": "/?share=route",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/?import=gpx",
      "name": "GPX Route Track",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/xml": [
          ".gpx"
        ]
      },
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "categories": [
    "health",
    "fitness",
    "sports",
    "navigation"
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Pace Plot Safe Route Map & Live Turn-by-Turn Voice Navigation"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Pace Plot Mobile Safe Loop Planner & Pedestrian Safety Metrics"
    },
    {
      "src": "/screenshot-health.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Pace Plot Personalized Heart Rate Zones & D3.js Weekly Workout Distribution"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Safe Voice Run",
      "short_name": "Start Run",
      "description": "Launch turn-by-turn voice-guided safe loop navigation",
      "url": "/?action=start-run",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Health & Heart Rate Zones",
      "short_name": "HR Zones",
      "description": "View personalized max heart rate zones and D3 weekly workout distribution",
      "url": "/?tab=health",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "SafeGuard SOS Beacon",
      "short_name": "SafeGuard",
      "description": "Activate live GPS safety beacon and emergency contacts",
      "url": "/?tab=safety",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Pace Plot Safe Run & HR Readiness",
      "short_name": "Pace Plot",
      "description": "Quickly view your weekly miles, Zone 2 aerobic base time, and launch a safe voice-guided loop.",
      "tag": "paceplot-readiness",
      "template": "paceplot-readiness-template",
      "ms_ac_template": "/widgets/paceplot-widget-template.json",
      "data": "/widgets/paceplot-widget-data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "multiple": false,
      "screenshots": [
        {
          "src": "/screenshot-narrow.png",
          "sizes": "540x960",
          "type": "image/png",
          "label": "Pace Plot Readiness Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "backgrounds": []
    }
  ]
}
